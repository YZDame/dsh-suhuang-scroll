{
  "name": "dsh-suhuang-scroll",
  "version": "0.2.0",
  "description": "DeepSeek Harness settings section and sidebar runtime console for Suhuang Scroll",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YZDame/dsh-suhuang-scroll.git"
  },
  "homepage": "https://github.com/YZDame/dsh-suhuang-scroll#readme",
  "bugs": {
    "url": "https://github.com/YZDame/dsh-suhuang-scroll/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-better-sidebar",
    "deepseek-harness",
    "suhuang-scroll",
    "grading"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "runtime.js",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check runtime.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "dsh-better-sidebar": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  }
}
