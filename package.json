{
  "name": "dsh-suhuang-scroll",
  "version": "0.7.0",
  "description": "DeepSeek Harness settings section and grading console for Suhuang Scroll",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YZDame/dsh-suhuang-scroll.git"
  },
  "homepage": "https://github.com/YZDame/dsh-suhuang-scroll#readme",
  "bugs": {
    "url": "https://github.com/YZDame/dsh-suhuang-scroll/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "suhuang-scroll",
    "grading"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "runtime.js",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "pretest": "npm run build:check",
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check runtime.js"
  },
  "devDependencies": {
    "esbuild": "0.27.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*"
  }
}
